<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyiliteflow.aikit.platform.mapper.AiKnowledgeChunkMapper">
    <resultMap id="ChunkResult" type="com.ruoyiliteflow.aikit.platform.domain.AiKnowledgeChunk">
        <id property="id" column="id"/>
        <result property="kbId" column="kb_id"/>
        <result property="docId" column="doc_id"/>
        <result property="chunkIndex" column="chunk_index"/>
        <result property="content" column="content"/>
    </resultMap>
    <select id="selectByKbId" resultMap="ChunkResult">
        select id, kb_id, doc_id, chunk_index, content from ai_knowledge_chunk
        where kb_id = #{kbId} order by doc_id, chunk_index
    </select>
    <insert id="insertBatch">
        insert into ai_knowledge_chunk (kb_id, doc_id, chunk_index, content, create_time) values
        <foreach collection="list" item="c" separator=",">
            (#{c.kbId}, #{c.docId}, #{c.chunkIndex}, #{c.content}, sysdate())
        </foreach>
    </insert>
    <delete id="deleteByKbId">
        delete from ai_knowledge_chunk where kb_id = #{kbId}
    </delete>
    <delete id="deleteByDocId">
        delete from ai_knowledge_chunk where doc_id = #{docId}
    </delete>
    <select id="countByKbId" resultType="int">
        select count(1) from ai_knowledge_chunk where kb_id = #{kbId}
    </select>
</mapper>
