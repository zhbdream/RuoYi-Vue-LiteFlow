<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyiliteflow.aikit.platform.mapper.AiContextPolicyMapper">

    <resultMap id="AiContextPolicyResult" type="com.ruoyiliteflow.aikit.platform.domain.AiContextPolicy">
        <id     property="id"               column="id"/>
        <result property="policyCode"       column="policy_code"/>
        <result property="policyName"       column="policy_name"/>
        <result property="windowSize"       column="window_size"/>
        <result property="enableSummary"    column="enable_summary"/>
        <result property="variableTemplate" column="variable_template"/>
        <result property="tokenBudget"      column="token_budget"/>
        <result property="isDefault"        column="is_default"/>
        <result property="enabled"          column="enabled"/>
        <result property="createBy"         column="create_by"/>
        <result property="createTime"       column="create_time"/>
        <result property="updateBy"         column="update_by"/>
        <result property="updateTime"       column="update_time"/>
        <result property="remark"           column="remark"/>
    </resultMap>

    <sql id="selectVo">
        select id, policy_code, policy_name, window_size, enable_summary, variable_template, token_budget,
               is_default, enabled, create_by, create_time, update_by, update_time, remark
        from ai_context_policy
    </sql>

    <select id="selectAiContextPolicyList" parameterType="com.ruoyiliteflow.aikit.platform.domain.AiContextPolicy" resultMap="AiContextPolicyResult">
        <include refid="selectVo"/>
        <where>
            <if test="policyCode != null and policyCode != ''">AND policy_code like concat('%', #{policyCode}, '%')</if>
            <if test="enabled != null and enabled != ''">AND enabled = #{enabled}</if>
            <if test="policyName != null and policyName != ''">AND policy_name like concat('%', #{policyName}, '%')</if>
        </where>
        order by is_default desc, id desc
    </select>

    <select id="selectAiContextPolicyById" parameterType="Long" resultMap="AiContextPolicyResult">
        <include refid="selectVo"/> where id = #{id}
    </select>

    <select id="selectAiContextPolicyByCode" parameterType="String" resultMap="AiContextPolicyResult">
        <include refid="selectVo"/> where policy_code = #{policyCode}
    </select>

    <select id="selectDefaultEnabled" resultMap="AiContextPolicyResult">
        <include refid="selectVo"/>
        where enabled = '1' and is_default = '1'
        order by id desc limit 1
    </select>

    <insert id="insertAiContextPolicy" parameterType="com.ruoyiliteflow.aikit.platform.domain.AiContextPolicy" useGeneratedKeys="true" keyProperty="id">
        insert into ai_context_policy (
            policy_code, policy_name, window_size, enable_summary, variable_template, token_budget,
            is_default, enabled, create_by, create_time, remark
        ) values (
            #{policyCode}, #{policyName}, #{windowSize}, #{enableSummary}, #{variableTemplate}, #{tokenBudget},
            #{isDefault}, #{enabled}, #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateAiContextPolicy" parameterType="com.ruoyiliteflow.aikit.platform.domain.AiContextPolicy">
        update ai_context_policy
        <set>
            <if test="policyCode != null and policyCode != ''">policy_code = #{policyCode},</if>
            <if test="policyName != null">policy_name = #{policyName},</if>
            <if test="windowSize != null">window_size = #{windowSize},</if>
            <if test="enableSummary != null">enable_summary = #{enableSummary},</if>
            <if test="variableTemplate != null">variable_template = #{variableTemplate},</if>
            <if test="tokenBudget != null">token_budget = #{tokenBudget},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteAiContextPolicyByIds">
        delete from ai_context_policy where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <update id="clearDefaultFlag">
        update ai_context_policy set is_default = '0'
        <if test="excludeId != null">where id != #{excludeId}</if>
    </update>
</mapper>
