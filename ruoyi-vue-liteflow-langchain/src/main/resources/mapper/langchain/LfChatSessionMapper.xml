<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyiliteflow.langchain.mapper.LfChatSessionMapper">

    <resultMap type="com.ruoyiliteflow.langchain.domain.LfChatSession" id="LfChatSessionResult">
        <id     property="id"         column="id" />
        <result property="title"      column="title" />
        <result property="userName"   column="user_name" />
        <result property="modelCode"  column="model_code" />
        <result property="modelName"  column="model_name" />
        <result property="agentCode"  column="agent_code" />
        <result property="status"     column="status" />
        <result property="createBy"   column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark" />
    </resultMap>

    <sql id="selectVo">
        select id, title, user_name, model_code, model_name, agent_code, status,
               create_by, create_time, update_by, update_time, remark
        from lf_chat_session
    </sql>

    <select id="selectLfChatSessionList" parameterType="com.ruoyiliteflow.langchain.domain.LfChatSession" resultMap="LfChatSessionResult">
        <include refid="selectVo"/>
        <where>
            status = '0'
            <if test="userName != null and userName != ''">AND user_name = #{userName}</if>
            <if test="title != null and title != ''">AND title like concat('%', #{title}, '%')</if>
        </where>
        order by update_time desc, id desc
    </select>

    <select id="selectLfChatSessionById" parameterType="Long" resultMap="LfChatSessionResult">
        <include refid="selectVo"/> where id = #{id} and status = '0'
    </select>

    <insert id="insertLfChatSession" parameterType="com.ruoyiliteflow.langchain.domain.LfChatSession" useGeneratedKeys="true" keyProperty="id">
        insert into lf_chat_session (
            title, user_name, model_code, model_name, agent_code, status,
            create_by, create_time, update_by, update_time, remark
        ) values (
            #{title}, #{userName}, #{modelCode}, #{modelName}, #{agentCode}, #{status},
            #{createBy}, sysdate(), #{updateBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateLfChatSession" parameterType="com.ruoyiliteflow.langchain.domain.LfChatSession">
        update lf_chat_session
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="modelCode != null">model_code = #{modelCode},</if>
            <if test="modelName != null">model_name = #{modelName},</if>
            <if test="agentCode != null">agent_code = #{agentCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id}
    </update>

    <update id="deleteLfChatSessionByIds" parameterType="Long">
        update lf_chat_session set status = '1', update_time = sysdate()
        where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>
