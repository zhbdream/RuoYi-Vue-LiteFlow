# syntax=docker/dockerfile:1

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

COPY docker/maven-settings.xml /root/.m2/settings.xml
# 完整源码（含 ai-kit/ 聚合模块）；-am 会解析 admin 全部依赖
COPY . .
RUN mvn -pl ruoyi-vue-liteflow-admin -am package -DskipTests \
    && cp ruoyi-vue-liteflow-admin/target/ruoyi-vue-liteflow-admin.jar /app/app.jar

FROM eclipse-temurin:17-jre
WORKDIR /app
RUN mkdir -p /home/ruoyi/uploadPath
COPY --from=build /app/app.jar app.jar
ENV JAVA_OPTS="-Xms256m -Xmx1024m"
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
