<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyiliteflow.agent.mapper.LfAgentModelMapper">

    <resultMap type="com.ruoyiliteflow.agent.domain.LfAgentModel" id="LfAgentModelResult">
        <id     property="id"               column="id" />
        <result property="modelCode"        column="model_code" />
        <result property="modelName"        column="model_name" />
        <result property="provider"         column="provider" />
        <result property="configKey"        column="config_key" />
        <result property="baseUrl"          column="base_url" />
        <result property="model"            column="model" />
        <result property="apiKeyEnc"        column="api_key_enc" />
        <result property="status"           column="status" />
        <result property="isDefault"        column="is_default" />
        <result property="dailyCallLimit"   column="daily_call_limit" />
        <result property="dailyTokenLimit"  column="daily_token_limit" />
        <result property="createBy"         column="create_by" />
        <result property="createTime"       column="create_time" />
        <result property="updateBy"         column="update_by" />
        <result property="updateTime"       column="update_time" />
        <result property="remark"           column="remark" />
    </resultMap>

    <sql id="selectVo">
        select id, model_code, model_name, provider, config_key, base_url, model, api_key_enc,
               status, is_default, daily_call_limit, daily_token_limit,
               create_by, create_time, update_by, update_time, remark
        from lf_agent_model
    </sql>

    <select id="selectLfAgentModelList" parameterType="com.ruoyiliteflow.agent.domain.LfAgentModel" resultMap="LfAgentModelResult">
        <include refid="selectVo"/>
        <where>
            <if test="modelCode != null and modelCode != ''">AND model_code like concat('%', #{modelCode}, '%')</if>
            <if test="provider != null and provider != ''">AND provider = #{provider}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="modelName != null and modelName != ''">AND model_name like concat('%', #{modelName}, '%')</if>
        </where>
        order by is_default desc, id desc
    </select>

    <select id="selectLfAgentModelById" parameterType="Long" resultMap="LfAgentModelResult">
        <include refid="selectVo"/> where id = #{id}
    </select>

    <select id="selectLfAgentModelByCode" parameterType="String" resultMap="LfAgentModelResult">
        <include refid="selectVo"/> where model_code = #{modelCode}
    </select>

    <select id="selectDefaultEnabled" resultMap="LfAgentModelResult">
        <include refid="selectVo"/>
        where status = '0' and is_default = '1'
        order by id desc limit 1
    </select>

    <insert id="insertLfAgentModel" parameterType="com.ruoyiliteflow.agent.domain.LfAgentModel" useGeneratedKeys="true" keyProperty="id">
        insert into lf_agent_model (
            model_code, model_name, provider, config_key, base_url, model, api_key_enc,
            status, is_default, daily_call_limit, daily_token_limit,
            create_by, create_time, remark
        ) values (
            #{modelCode}, #{modelName}, #{provider}, #{configKey}, #{baseUrl}, #{model}, #{apiKeyEnc},
            #{status}, #{isDefault}, #{dailyCallLimit}, #{dailyTokenLimit},
            #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateLfAgentModel" parameterType="com.ruoyiliteflow.agent.domain.LfAgentModel">
        update lf_agent_model
        <set>
            <if test="modelCode != null and modelCode != ''">model_code = #{modelCode},</if>
            <if test="modelName != null">model_name = #{modelName},</if>
            <if test="provider != null and provider != ''">provider = #{provider},</if>
            <if test="configKey != null and configKey != ''">config_key = #{configKey},</if>
            <if test="baseUrl != null">base_url = #{baseUrl},</if>
            <if test="model != null and model != ''">model = #{model},</if>
            <if test="apiKeyEnc != null">api_key_enc = #{apiKeyEnc},</if>
            <if test="status != null">status = #{status},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="dailyCallLimit != null">daily_call_limit = #{dailyCallLimit},</if>
            <if test="dailyTokenLimit != null">daily_token_limit = #{dailyTokenLimit},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id}
    </update>

    <update id="clearDefaultFlag">
        update lf_agent_model set is_default = '0'
        <where>
            <if test="excludeId != null">id &lt;&gt; #{excludeId}</if>
        </where>
    </update>

    <delete id="deleteLfAgentModelById" parameterType="Long">
        delete from lf_agent_model where id = #{id}
    </delete>

    <delete id="deleteLfAgentModelByIds" parameterType="Long">
        delete from lf_agent_model where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
