<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyiliteflow.aikit.platform.mapper.AiKnowledgeBaseMapper">
    <resultMap id="KbResult" type="com.ruoyiliteflow.aikit.platform.domain.AiKnowledgeBase">
        <id property="id" column="id"/>
        <result property="kbCode" column="kb_code"/>
        <result property="kbName" column="kb_name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="chunkCount" column="chunk_count"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectVo">
        select id, kb_code, kb_name, description, status, chunk_count,
               create_by, create_time, update_by, update_time, remark
        from ai_knowledge_base
    </sql>
    <select id="selectAiKnowledgeBaseList" resultMap="KbResult">
        <include refid="selectVo"/>
        <where>
            <if test="kbCode != null and kbCode != ''">AND kb_code like concat('%', #{kbCode}, '%')</if>
            <if test="kbName != null and kbName != ''">AND kb_name like concat('%', #{kbName}, '%')</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        order by id desc
    </select>
    <select id="selectAiKnowledgeBaseById" resultMap="KbResult">
        <include refid="selectVo"/> where id = #{id}
    </select>
    <select id="selectAiKnowledgeBaseByCode" resultMap="KbResult">
        <include refid="selectVo"/> where kb_code = #{kbCode}
    </select>
    <insert id="insertAiKnowledgeBase" useGeneratedKeys="true" keyProperty="id">
        insert into ai_knowledge_base (kb_code, kb_name, description, status, chunk_count, create_by, create_time, remark)
        values (#{kbCode}, #{kbName}, #{description}, #{status}, #{chunkCount}, #{createBy}, sysdate(), #{remark})
    </insert>
    <update id="updateAiKnowledgeBase">
        update ai_knowledge_base
        <set>
            <if test="kbCode != null and kbCode != ''">kb_code = #{kbCode},</if>
            <if test="kbName != null">kb_name = #{kbName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="chunkCount != null">chunk_count = #{chunkCount},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id}
    </update>
    <update id="updateChunkCount">
        update ai_knowledge_base set chunk_count = #{chunkCount}, update_time = sysdate() where id = #{id}
    </update>
    <delete id="deleteAiKnowledgeBaseByIds">
        delete from ai_knowledge_base where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
